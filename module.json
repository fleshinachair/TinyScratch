","name":"Clip Pad","type":"int","min":0,"max":16,"default":0},{"key":"clip_delete","name":"Delete Clip","type":"int","min":0,"max":16,"default":0},{"key":"zoom","name":"Zoom","type":"int","min":0,"max":3,"default":0},{"key":"sample_file","name":"Load Sample","type":"filepath","root":"/data/UserData/UserLibrary/Samples","start_path":"/data/UserData/UserLibrary/Samples","filter":".wav","default":""},{"key":"pad_raw","name":"Pads Screen","type":"int","min":0,"max":1,"default":0},{"key":"pad_cuts","name":"Pad Cuts","type":"int","min":0,"max":65535,"default":0},{"key":"scratcher","name":"Scratcher","type":"canvas","canvas_script":"scratcher.js","as_page":true,"page_first":true,"show_value":false,"extra_keys":["view"]},{"key":"waveform","name":"Waveform","type":"canvas","canvas_script":"waveform.js","as_page":true,"show_value":false,"extra_keys":["view"]},{"key":"pads_screen","name":"Pads","type":"canvas","canvas_script":"scratcher.js","show_value":false,"show_footer":false,"fullscreen_live_ms":50,"extra_keys":["view"]},{"key":"view","name":"View","type":"string","access":"read","live":true}],
